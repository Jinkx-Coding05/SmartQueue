{
  "name": "smartqueue-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node --test",
    "test:e2e": "npm run build && playwright test",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "server:dev": "node --watch --experimental-strip-types server/src/index.ts",
    "server:start": "node dist-server/index.js",
    "admin:provision": "node --experimental-strip-types server/src/scripts/provisionAdmin.ts",
    "citizen:provision": "node --experimental-strip-types server/src/scripts/provisionCitizen.ts",
    "test-accounts:seed": "node --experimental-strip-types server/src/scripts/seedTestAccounts.ts",
    "test-accounts:remove": "node --experimental-strip-types server/src/scripts/removeTestAccounts.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^14.14.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.77.0",
    "mongoose": "^9.12.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
