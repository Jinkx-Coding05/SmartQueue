PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/smartqueue_ai?retryWrites=true&w=majority
# Optional isolated development/test database. Test scripts require a distinct database name ending in _test.
MONGODB_TEST_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/smartqueue_ai_test?retryWrites=true&w=majority
ALLOW_TEST_DATA_SEEDING=false
TEST_ADMIN_FULL_NAME=SmartQueue Test Admin
TEST_ADMIN_EMAIL=
TEST_ADMIN_PHONE=
TEST_ADMIN_PASSWORD=
TEST_CITIZEN_FULL_NAME=SmartQueue Test Citizen
TEST_CITIZEN_EMAIL=
TEST_CITIZEN_PHONE=
TEST_CITIZEN_PASSWORD=
CLIENT_URL=http://localhost:5173
CLIENT_URLS=https://your-smartqueue.vercel.app
HOSPITAL_TIME_ZONE=Asia/Kolkata
DEFAULT_SERVICE_DURATION_MINUTES=2
CITIZEN_ARRIVAL_BUFFER_MINUTES=15
NODE_ENV=development

# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
AUTH_TOKEN_TTL_SECONDS=900
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RESET_TOKEN_TTL_MINUTES=15
# Set true only for local development without a delivery provider.
AUTH_OTP_TTL_MINUTES=10
DEV_OTP_EXPOSE=false
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Server-only Resend credentials. In production, OTP_FROM_EMAIL must use your verified Resend domain.
RESEND_API_KEY=your_resend_api_key_here
OTP_FROM_EMAIL=onboarding@resend.dev
# Development only. If enabled, forgot-password returns a one-time test token in its response.
AUTH_RESET_TOKEN_EXPOSE=false

# Optional server-side Gemini enhancement. Without a key, insights use rule-based analytics.
GEMINI_API_KEY=REPLACE_WITH_SERVER_SIDE_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_CACHE_TTL_MS=120000
GEMINI_RATE_LIMIT_WINDOW_MS=60000
GEMINI_RATE_LIMIT_MAX=12

# Gemini uses only bounded aggregate data and falls back to rule-based insights if unavailable.

# Set all four only when running the server-side admin provisioning script.
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Set all four only when running the server-side citizen provisioning script.
CITIZEN_FULL_NAME=
CITIZEN_EMAIL=
CITIZEN_PHONE=
CITIZEN_PASSWORD=
